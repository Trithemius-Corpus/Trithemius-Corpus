# Build / OS
*.pyc
__pycache__/
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Source PDFs — provenance documented in manifest.json; not redistributed
# (Public domain originals are available from the institutions listed in the manifest.)
*.pdf

# site/dist/ is intentionally NOT ignored: it is the published GitHub Pages
# artifact and CANNOT be rebuilt in CI — scripts/build_site.py needs the
# working corpus (Latin source + translations) which is deliberately not in
# this repo. Build locally with build_site.py and commit site/dist/.
site/public/
site/resources/
docs/_site/
docs/.jekyll-cache/

# Per-cluster sentence-embedding indices (regenerable from data/anchors/*.jsonl
# via scripts/build_retrieval_index.py — ~25 KB per cluster, but kept out of git
# so the repo stays source-of-truth for the curated pairs).
data/retrieval/

# Model caches / embeddings — too large for git
models/
*.gguf
*.safetensors
*.bin
embeddings/
*.faiss

# OCR working files
ocr-pages/
*.tesseract.tmp

# Style C source facsimiles: regenerable from the working corpus via
# scripts/build_facsimiles.py (PNG page scans -> WebP). The SOURCE copy under
# site/static/images/<work>/ is ignored to avoid committing every page twice;
# the SERVED copy under site/dist/static/images/<work>/ (produced by
# build_site.py copy_static) IS committed, because GitHub Pages deploys
# site/dist/ verbatim and CI cannot rebuild it. The landing-hero
# site/static/images/clavis-source-page.webp stays tracked (not matched here).
site/static/images/prdl-*/

