{% extends "base.html.j2" %}
{% block title %}Witness Comparison &mdash; Trithemius Corpus{% endblock %}
{% block head %}<link rel="stylesheet" href="{{ asset('witness-comparison.css') }}">{% endblock %}
{% block body %}
<article class="witness-edition" data-witness-comparison>
  <header>
    <p class="eyebrow">Human-verified witness comparison</p>
    <h1>{{ comparison.title }}</h1>
    <p class="lede">A four-line pilot collated directly from three digitized editions of <em>{{ comparison.work }}</em>. The display separates what the witnesses print from normalization and from OCR behavior.</p>
  </header>

  <aside class="comparison-caution">
    <strong>OCR is not variation.</strong> {{ comparison.editorial_note }}
  </aside>

  <div class="layer-switch" role="group" aria-label="Transcription layer">
    <button type="button" data-layer="diplomatic" aria-pressed="true">Diplomatic</button>
    <button type="button" data-layer="normalized" aria-pressed="false">Normalized</button>
  </div>

  <section aria-labelledby="witnesses-heading">
    <h2 id="witnesses-heading">The witnesses</h2>
    <p class="comparison-help">Read each column independently. The restrained ribbons simply keep corresponding verse lines in view; they carry no claim about descent or dependence.</p>
    <div class="comparison-stage">
      <svg class="comparison-ribbons" aria-hidden="true"></svg>
      <div class="witness-grid">
      {% for witness in comparison.witnesses %}
        <article class="witness-card" id="witness-{{ witness.id }}">
          <header><h3><span class="siglum">{{ witness.siglum }}</span> {{ witness.label }}</h3><p>{{ witness.locator }}</p></header>
          <ol class="witness-lines witness-lines-diplomatic" lang="la">
            {% for line in witness.diplomatic %}<li data-verse-line="{{ loop.index }}">{{ line }}</li>{% endfor %}
          </ol>
          <ol class="witness-lines witness-lines-normalized" lang="la" hidden>
            {% for line in witness.normalized %}<li data-verse-line="{{ loop.index }}">{{ line }}</li>{% endfor %}
          </ol>
          <p class="witness-links"><a href="{{ witness.canvas }}">Open facsimile at {{ witness.locator }}</a> · <a href="{{ witness.manifest }}">IIIF manifest</a></p>
          <details><summary>Bibliographic record</summary><p>{{ witness.bibliography }}</p></details>
        </article>
      {% endfor %}
      </div>
    </div>
  </section>

  <section aria-labelledby="apparatus-heading">
    <h2 id="apparatus-heading">Collation and classification</h2>
    <div class="variant-summary" aria-label="Variation totals">
      {% for key, label in [('substantive','Substantive'),('orthographic','Orthographic / abbreviation'),('punctuation','Punctuation'),('unresolved','Unresolved')] %}
      <span><strong>{{ comparison.summary[key] }}</strong> {{ label }}</span>
      {% endfor %}
    </div>
    <div class="table-scroll"><table class="apparatus-table">
      <caption>Every classified textual variation unit; readings link back to their witness facsimiles.</caption>
      <thead><tr><th scope="col">Line / class</th><th scope="col">Lemma</th>{% for witness in comparison.witnesses %}<th scope="col">{{ witness.siglum }}</th>{% endfor %}<th scope="col">Editorial note</th></tr></thead>
      <tbody>{% for unit in comparison.variation_units %}<tr>
        <th scope="row">{{ unit.line }} · {{ unit.type }}</th><td lang="la">{{ unit.lemma }}</td>
        {% for witness in comparison.witnesses %}<td lang="la"><a href="{{ witness.canvas }}">{{ unit.readings[witness.id] }}</a></td>{% endfor %}
        <td>{{ unit.note }}</td>
      </tr>{% endfor %}</tbody>
    </table></div>
  </section>

  <section class="ocr-audit" aria-labelledby="ocr-heading">
    <h2 id="ocr-heading">OCR audit trail</h2>
    <p>These disagreements were checked against the scans and excluded from the apparatus. They describe machine recognition, not the transmitted text.</p>
    <ul>{% for item in comparison.ocr_observations %}<li><strong>{{ item.witness }}</strong>: OCR <s lang="la">{{ item.reported }}</s> → verified <span lang="la">{{ item.verified }}</span>. {{ item.note }}</li>{% endfor %}</ul>
  </section>

  <section class="comparison-provenance">
    <h2>Editorial record and downloads</h2>
    <p><strong>{{ comparison.verified.status }}</strong>, {{ comparison.verified.date }}. {{ comparison.verified.scope }}</p>
    <p>{{ comparison.verified.conventions }}</p>
    <p><a download href="{{ url('data/witness-comparisons/anna-tetrastichon.tei.xml') }}">Download TEI apparatus</a> · <a download href="{{ url('data/witness-comparisons/anna-tetrastichon.tsv') }}">Download TSV</a> · <a download href="{{ url('data/witness-comparisons/anna-tetrastichon.json') }}">Download JSON</a></p>
  </section>
</article>
<script src="{{ asset('witness-comparison.js') }}" defer></script>
{% endblock %}
