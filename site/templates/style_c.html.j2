{% extends "base.html.j2" %}
{% from "_macros.html.j2" import breadcrumb with context %}
{% block title %}{{ work.title }} &mdash; {{ content_type.label }} &mdash; Trithemius Corpus{% endblock %}
{% block body %}

<article class="style-c-page">
{{ breadcrumb([("index.html", "Home"), ("works.html", "Works"),
               ("works/" + work.id + ".html", work.title),
               (None, content_type.label)]) }}

<header class="work-header">
  <h2 class="work-title">{{ work.title }}</h2>
  {% if work.title_en %}<p class="work-subtitle">{{ work.title_en }}</p>{% endif %}
  <p class="work-id"><code>{{ work.id }}</code> &middot; Style&nbsp;C / <strong>{{ content_type.label }}</strong></p>
  <div class="badges">
    <span class="badge status-origin">{{ work.text_origin }}</span>
    <span class="badge status-review">{{ work.human_review }}</span>
    <span class="badge">{{ content_type.n }}&nbsp;{{ 'chunk' if content_type.n == 1 else 'chunks' }}</span>
    {% if work.genre %}<a class="badge badge-link" href="{{ url('genres/' + work.genre + '.html') }}">{{ work.genre_label }}</a>{% endif %}
  </div>
</header>

{% if siblings and siblings|length > 1 %}
<nav class="style-c-tabs" aria-label="Other renderings for this work">
  {% for sib in siblings %}
  {% if sib.key == content_type.key %}
  <span class="style-c-tab active" aria-current="page">{{ sib.label }} <span class="tab-n">{{ sib.n }}</span></span>
  {% else %}
  <a class="style-c-tab" href="{{ url('works/' + work.id + '_style-c-' + sib.key + '.html') }}">{{ sib.label }} <span class="tab-n">{{ sib.n }}</span></a>
  {% endif %}
  {% endfor %}
</nav>
{% endif %}

{% if content_type.intro_html %}
<section class="style-c-intro">
{{ content_type.intro_html|safe }}
</section>
{% endif %}

<section class="style-c-chunks">
  <h3 id="chunks">Per-chunk renderings</h3>
  {% if content_type.chunks|length > 8 %}
  <nav class="style-c-index" aria-label="Jump to chunk">
    <span class="idx-label">Jump to:</span>
    {% for chunk in content_type.chunks %}<a href="#{{ chunk.name }}">{{ chunk.name|replace('full_chunk_', '') }}{% if chunk.pages %}<span class="idx-pg">p{{ chunk.pages[0].n }}</span>{% endif %}</a>{% endfor %}
  </nav>
  {% endif %}
  {% for chunk in content_type.chunks %}
  <article class="style-c-chunk" id="{{ chunk.name }}">
    <div class="style-c-pair{% if not chunk.pages %} no-facsimile{% endif %}">
      {% if chunk.pages %}
      <figure class="style-c-facsimile">
        {% for pg in chunk.pages %}
        <a class="facs-link" href="{{ asset(pg.src) }}" target="_blank" rel="noopener"
           title="Open full source page {{ pg.n }} in a new tab">
          <img src="{{ asset(pg.thumb) }}" loading="lazy" decoding="async"
               alt="Source facsimile, page {{ pg.n }}{% if pg.approx %} (approximate){% endif %}">
        </a>
        {% endfor %}
        <figcaption>
          Source facsimile &middot;
          {% if chunk.pages|length == 1 %}page {{ chunk.pages[0].n }}{% else %}pages {{ chunk.pages|map(attribute='n')|join(', ') }}{% endif %}{% if chunk.pages[0].approx %} (approx.){% endif %}
          {% if content_type.source and content_type.source.provider %}
          &middot; {% if content_type.source.url %}<a href="{{ content_type.source.url }}">{{ content_type.source.provider }}</a>{% else %}{{ content_type.source.provider }}{% endif %}
          {% endif %}
          <span class="facs-hint">click to enlarge</span>
        </figcaption>
      </figure>
      {% endif %}
      <div class="style-c-rendering">
        {{ chunk.html|safe }}
      </div>
    </div>
    <nav class="style-c-toolbar" aria-label="Rendering links">
      <a href="#{{ chunk.name }}">#</a>
      <a href="#chunks">Top</a>
      <a href="{{ url('works/' + work.id + '.html') }}">Back to work</a>
    </nav>
  </article>
  {% endfor %}
</section>

</article>

<dialog id="facs-box" class="facs-dialog" aria-label="Source facsimile, enlarged">
  <button type="button" class="facs-close">Close &#10005;</button>
  <img data-empty alt aria-hidden="true">
  <p class="facs-cap muted"></p>
</dialog>
<script>
/* Keyboard-accessible in-page zoom for the facsimiles. The <dialog> element
   handles Esc and focus natively; without JS the links keep their default
   open-in-new-tab behaviour. */
(() => {
  const box = document.getElementById("facs-box");
  if (!box || typeof box.showModal !== "function") return;
  const img = box.querySelector("img");
  const cap = box.querySelector(".facs-cap");
  document.querySelectorAll("a.facs-link").forEach((a) => {
    a.addEventListener("click", (e) => {
      e.preventDefault();
      const thumb = a.querySelector("img");
      img.src = a.href;
      img.alt = thumb ? thumb.alt : "Source facsimile";
      const raw = document.createElement("a");
      raw.href = a.href; raw.target = "_blank"; raw.rel = "noopener";
      raw.textContent = "full image in a new tab";
      cap.replaceChildren(
        document.createTextNode(img.alt + " — Esc to close, or open the "),
        raw, document.createTextNode("."));
      box.showModal();
    });
  });
  box.addEventListener("click", (e) => { if (e.target === box) box.close(); });
  box.querySelector(".facs-close").addEventListener("click", () => box.close());
})();

/* Wide-table layout: if a chunk's substitution table is wider than the
   rendering column it would occupy in the two-column grid, stack that chunk
   (facsimile above, full-width table below) instead of forcing a cramped
   horizontal scroll inside the grid.

   To avoid a measure→stack→remeasure oscillation we measure the table's
   NATURAL width (scrollWidth never changes with layout) against a STABLE
   reference: half the pair width (the grid gives the rendering ~1.1/(0.9+1.1)
   of the pair, but we use a conservative threshold so borderline tables stay
   in the grid). Once a chunk is tagged wide it stays wide until the viewport
   changes substantially. */
(() => {
  const STACK_RATIO = 0.62;  // stack if table needs more than 62% of pair width
  const tag = () => {
    const pair = document.querySelector(".style-c-pair");
    const pairW = pair ? pair.getBoundingClientRect().width : 0;
    if (!pairW) return;
    const threshold = pairW * STACK_RATIO;
    document.querySelectorAll(".style-c-pair").forEach((p) => {
      const scroller = p.querySelector(".table-scroll");
      const tbl = scroller ? scroller.querySelector("table") : null;
      if (!tbl) { p.removeAttribute("data-wide"); return; }
      // scrollWidth is layout-independent → stable across stack/unstack
      if (tbl.scrollWidth > threshold) p.setAttribute("data-wide", "");
      else p.removeAttribute("data-wide");
    });
  };
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(tag);
  window.addEventListener("load", tag);
  let t; window.addEventListener("resize", () => { clearTimeout(t); t = setTimeout(tag, 150); });
})();
</script>

{% endblock %}
