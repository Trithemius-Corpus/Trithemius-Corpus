{# Shared fragments. Import with context so url()/asset() resolve at the
   calling page's depth: {% from "_macros.html.j2" import breadcrumb, text_card with context %} #}

{% macro rights_summary() -%}
Translations &amp; generated data: CC0. Methodology, documentation, code &amp; corpus arrangement: CC BY 4.0.
<a href="{{ url('LICENSE.html') }}">License &amp; rights</a>.
{%- endmacro %}

{% macro translation_survey_badge(note='', status='none_located') -%}
<a class="badge first-en" href="{{ url('prior-translations.html') }}" title="Survey finding, not proof of priority. {{ note or 'No prior complete published English translation located in the project survey.' }}">{{ 'Prior English: partial' if status == 'partial_prior' else 'Survey unresolved' if status == 'unresolved' else 'No prior complete English located' }}</a>
{%- endmacro %}

{% macro breadcrumb(crumbs) %}
<nav class="breadcrumb" aria-label="Breadcrumb">
  {% for href, label in crumbs %}
  {% if href %}<a href="{{ url(href) }}">{{ label }}</a>{% else %}<span class="crumb-here" aria-current="page">{{ label }}</span>{% endif %}
  {% if not loop.last %}<span class="crumb-sep" aria-hidden="true">&rsaquo;</span>{% endif %}
  {% endfor %}
  <button type="button" class="pdf-btn" onclick="window.print()">Save as PDF</button>
</nav>
{% endmacro %}

{% macro text_card(t) %}
<article class="text-card" data-search="{{ (t.title ~ ' ' ~ (t.title_en or '') ~ ' ' ~ (t.genre_label or '') ~ ' ' ~ (t.year or ''))|lower }}"
         data-genre="{{ t.genre }}" data-first="{{ '1' if t.first_english else '0' }}">
  <h3 class="text-card-title">
    <a href="{{ url('works/' + t.rep.id + '.html') }}"><em>{{ t.title }}</em></a>
  </h3>
  <p class="text-card-sub">
    {{ t.title_en }}{% if t.year %} &middot; {{ t.year }}{% endif %}
    {% if t.first_english or t.rep.translation_survey_status == 'unresolved' %}{{ translation_survey_badge(t.rep.first_english_note, t.rep.translation_survey_status) }}{% endif %}
  </p>
  {% if t.excerpt %}<p class="text-card-excerpt muted">{{ t.excerpt }}</p>{% endif %}
  <p class="text-card-editions muted">
    {% if t.editions|length == 1 %}
    {{ t.editions[0].label }} &middot; {{ t.editions[0].editorial_state|lower }}
    &middot; <a href="{{ url('works/' + t.editions[0].id + '_parallel.html') }}">Latin&thinsp;/&thinsp;English</a>
    {% else %}
    {{ t.editions|length }} editions:
    {% for e in t.editions %}<a href="{{ url('works/' + e.id + '.html') }}">{{ e.label }}</a>{% if not loop.last %} &middot; {% endif %}{% endfor %}
    {% endif %}
  </p>
</article>
{% endmacro %}
