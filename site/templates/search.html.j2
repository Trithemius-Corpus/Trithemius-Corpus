{% extends "base.html.j2" %}
{% block title %}Search &mdash; Trithemius Corpus{% endblock %}
{% block body %}
<section class="corpus-search">
  <h1>Search the corpus</h1>
  <p>Find an English translation, a Latin source segment, or an editorial note across the printed editions.</p>
  <form role="search" action="{{ url('search.html') }}" method="get" id="corpus-search-form"
        data-index="{{ url('pagefind/pagefind.js') }}">
    <label for="corpus-query">Words or phrase</label>
    <div class="corpus-query-row">
      <input type="search" id="corpus-query" name="q" enterkeyhint="search" autocomplete="off"
             aria-describedby="corpus-search-hint">
      <button type="submit">Search</button>
    </div>
    <p id="corpus-search-hint" class="muted">Use quotation marks for an exact phrase.</p>
  </form>
  <noscript><p>Enable JavaScript to search the local text index.</p></noscript>
  <p id="corpus-search-status" role="status" aria-live="polite" aria-atomic="true"></p>
  <div id="corpus-results"></div>
  <button id="corpus-retry" type="button" hidden>Retry incomplete search</button>
  <button id="corpus-more" type="button" hidden>Show more matching editions</button>
</section>
<script type="module" src="{{ asset('corpus-search.mjs') }}"></script>
{% endblock %}
