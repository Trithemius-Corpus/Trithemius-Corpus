{% extends "base.html.j2" %}
{% block title %}Quality tiers &mdash; Trithemius Corpus{% endblock %}
{% block body %}

<section>
  <h1>Quality tier table</h1>
  <p class="muted">
    Every translated edition is graded chunk-by-chunk against its own Latin (see
    <a href="{{ url('methodology.html') }}#6-historical-automated-grading-and-current-review-status">Methodology &sect;6</a>).
    Corpus-wide: {{ quality.chunks }} graded chunks, mean faithfulness
    {{ '%.2f'|format(quality.faithful) }}/5, and {{ '%.1f'|format(quality.hallucinated_pct) }}% flagged hallucinated.
    These are machine-assisted editorial ratings, not certification as human translations or critical editions.
    Looking for the reading index instead? <a href="{{ url('works.html') }}">Browse the works</a>.
  </p>
  <p class="callout">
    <strong>Conservative recalibration:</strong> every former S rating is now displayed as A.
    This is a one-level downgrade across the corpus; further work-by-work grading remains necessary.
  </p>
  <noscript><p class="muted">(Sorting needs JavaScript; the table below is pre-sorted by tier.)</p></noscript>

  <table class="works-table" id="works-table">
    <caption class="sr-only">Per-work quality scoreboard: tier, pages, genre cluster, faithfulness, fluency, and source-damage density.</caption>
    <thead><tr>
      <th scope="col"><button class="sort-btn" type="button" data-sort="tier">Tier</button></th>
      <th scope="col"><button class="sort-btn" type="button" data-sort="pages">Pages</button></th>
      <th scope="col"><button class="sort-btn" type="button" data-sort="cluster">Cluster</button></th>
      <th scope="col"><button class="sort-btn" type="button" data-sort="faith">Faithfulness</button></th>
      <th scope="col"><button class="sort-btn" type="button" data-sort="fluent">Fluency</button></th>
      <th scope="col"><button class="sort-btn" type="button" data-sort="gap">Damage density<sup>&dagger;</sup></button></th>
      <th scope="col"><button class="sort-btn" type="button" data-sort="work">Work</button></th>
    </tr></thead>
    <tbody>
      {% for w in works %}
      {% set display_tier = 'A' if w.tier == 'S' else (w.tier or 'U') %}
      <tr class="tier-{{ display_tier|lower }}"
          data-tier="{{ display_tier }}"
          data-pages="{{ w.page_count if w.page_count is not none else -1 }}"
          data-cluster="{{ w.genre_cluster or '' }}"
          data-faith="{{ w.faithful_adj if w.faithful_adj is not none else -1 }}"
          data-fluent="{{ w.fluent_adj if w.fluent_adj is not none else -1 }}"
          data-gap="{{ w.unclear_density if w.unclear_density is not none else -1 }}"
          data-work="{{ w.title|lower }}">
        <td class="tier-letter" data-label="Tier">{{ display_tier if display_tier != 'U' else '&mdash;' }}</td>
        <td class="num" data-label="Pages">{{ w.page_count or '&mdash;' }}</td>
        <td data-label="Cluster">{% if w.genre %}<a href="{{ url('genres/' + w.genre + '.html') }}">{{ w.genre_label }}</a>{% else %}&mdash;{% endif %}</td>
        <td class="num" data-label="Faithfulness">{{ '%.2f'|format(w.faithful_adj) if w.faithful_adj is not none else '&mdash;' }}</td>
        <td class="num" data-label="Fluency">{{ '%.2f'|format(w.fluent_adj) if w.fluent_adj is not none else '&mdash;' }}</td>
        <td class="num{% if w.unclear_density and w.unclear_density >= 5 %} gap-high{% elif w.unclear_density and w.unclear_density >= 3 %} gap-mid{% endif %}" data-label="Damage density" title="OCR damage density — [unclear] markers per segment">{{ '%.1f'|format(w.unclear_density) if w.unclear_density is not none else '&mdash;' }}</td>
        <td data-label="Work"><a href="{{ url('works/' + w.id + '.html') }}">{{ w.title }}</a>{% if w.edition_label %} <span class="ed-tag" title="One of {{ w.edition_count }} editions of this text in the corpus">{{ w.edition_label }}</span>{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <p class="muted scoreboard-note"><sup>&dagger;</sup> <strong>Damage density</strong> counts <code>[unclear]</code> markers per translated segment. Higher values indicate a rougher underlying scan, not necessarily a worse translation.</p>
</section>

<script>
(() => {
  const table = document.querySelector("#works-table");
  if (!table) return;
  const tbody = table.tBodies[0];
  const tierRank = { A: 0, B: 1, C: 2, F: 3, U: 4 };
  let activeSort = { key: "tier", dir: 1 };
  function value(row, key) {
    if (key === "tier") return tierRank[row.dataset.tier] ?? 9;
    if (["pages", "faith", "fluent", "gap"].includes(key)) return Number(row.dataset[key]);
    return row.dataset[key] || "";
  }
  function render() {
    const rows = Array.from(tbody.rows);
    rows.sort((a, b) => {
      const av = value(a, activeSort.key), bv = value(b, activeSort.key);
      return (typeof av === "number" && typeof bv === "number")
        ? (av - bv) * activeSort.dir
        : String(av).localeCompare(String(bv)) * activeSort.dir;
    });
    rows.forEach((row) => tbody.appendChild(row));
  }
  document.querySelectorAll("[data-sort]").forEach((button) => {
    button.addEventListener("click", () => {
      const key = button.dataset.sort;
      activeSort = { key, dir: activeSort.key === key ? activeSort.dir * -1 : 1 };
      render();
    });
  });
  render();
})();
</script>

{% endblock %}
